{
  "name": "Web Code Studio",
  "short_name": "WCS",
  "description": "Trình soạn thảo HTML, CSS, JavaScript chạy ngay trên trình duyệt với Live Preview và Console.",
  "lang": "vi",
  "start_url": "./index.html",
